<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link rel="stylesheet" href="/css/home.css" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/navbar1.css" />
    <link rel="stylesheet" href="/css/navbar2.css" />
    <link rel="stylesheet" href="/css/footer.css" />
  </head>

  <body>
     <div class="page-container">
    <div class="navbar">
  <div class="logo">
    <h1>DASHBOARD</h1>
  </div>

 

  <div class="login">
    <% if(userId){ %>
      <span class="user-id">ID: <%= userId %></span>
      <a href="/logout" class="btn">Logout</a>
    <% } else { %>
      <a href="/login" class="btn">Login</a>
    <% } %>
  </div>
</div>
    <div class="navbar2">
  <a class="nav2btn" href="/">Home</a>
  <a class="nav2btn" href="/xumoChat">Xumo Chat</a>
  <a class="nav2btn" href="/form">Xumo Tier2</a>
  <a class="nav2btn" href="/reports">Reports</a>
  <a class="nav2btn disabled">Daily Briefing Update Pending</a>
  <a class="nav2btn">Admin</a>
</div>
    <div class="content-wrap">
<div class="countBox">
      <div class="chatCount">
        <div class="text">Today's Tier 1 count</div>
        <h1><%= tier1Count %></h1>
      </div>

      <div class="chatCount">
        <div class="text">Today's Tier 2 count</div>
        <h1><%= tier2Count %></h1>
      </div>

      <div class="chatCount">
        <div class="text">Today's Total count</div>
        <h1><%= tier1Count + tier2Count %></h1>
      </div>
    </div>

    <!-- to upload any file/ img/vdo use enctype=multipart -->
    <form
      action="/upload-excel"
      method="POST"
      enctype="multipart/form-data" 
      class="excel-upload-form"
    >
      <label class="excel-upload">
        <input type="file" name="excelFile" accept=".xlsx" required hidden />
        <span class="upload-text">📄 Choose Excel File</span>
      </label>

      <button type="submit" class="upload-btn">⬆ Upload Excel</button>
    </form>

    <% if (gridTickets.length > 0&& userId) { %>

    <div class="gridCount">
      <h4>Pending Task Tickets: <%= gridTickets.length %></h4>
    </div>

    <div class="excel-grid">
      <% gridTickets.forEach(t => { %>
        
      <div class="cell <%= t.matched ? 'green': 'red' %>">
        <%= t.ticketNo %>
      </div>
      <% }) %>
    </div>

    <% } %>
    </div>
    

    <div class="footer">
      <h3>
        Copyright<?>
        2024 EMU. All Rights Reserved
      </h3>
    </div>
    </div>
  </body>
</html>
